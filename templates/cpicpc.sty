\newenvironment{example}[1][]{
  \ttfamily\obeylines\obeyspaces\frenchspacing
  \newcommand{\exmp}[3]{
    \setlength{\tabcolsep}{6pt}
    \renewcommand{\arraystretch}{1.5}
    \noindent
    \begin{tabular}{|l|l|}
    \multicolumn{1}{l}{\sffamily \textbf{\InputFileName~\###1}}&
    \multicolumn{1}{l}{\sffamily \textbf{\OutputFileName~\###1}}\\
    \hline
    \begin{minipage}[t]{\exmpwidinf}\rightskip=0pt plus 1fill\relax##2\rule[0pt]{0pt}{0pt}\end{minipage}&
    \begin{minipage}[t]{\exmpwidouf}\rightskip=0pt plus 1fill\relax##3\rule[0pt]{0pt}{0pt}\end{minipage}\\
    \hline
    \end{tabular}
    \renewcommand{\arraystretch}{1}
  }
}{
}

\newcommand{\iobox}[1]{%
  \fbox{\parbox[t]{0.6\textwidth}{\raggedright\ttfamily #1\strut}}%
}